<!--
  Biyagama Junction — Node Definitions
  =====================================
  Biyagama is SOUTH of Kaduwela. Green Wave offset = 270 s.
    Distance from Kaduwela: ~3 000 m  |  Speed: 40 km/h → 270 s travel time

  Compass layout (local to this junction):
    North  → Kaduwela     (GREEN WAVE link back to origin)
    East   → Industrial Zone
    West   → Kelaniya
-->
<nodes>
    <node id="biyagama_center" x="0.0"    y="0.0"    type="traffic_light"/>
    <node id="kaduwela"        x="0.0"    y="500.0"  type="priority"/>  <!-- North  -->
    <node id="industrial"      x="500.0"  y="0.0"    type="priority"/>  <!-- East   -->
    <node id="kelaniya"        x="-500.0" y="0.0"    type="priority"/>  <!-- West   -->
</nodes>
