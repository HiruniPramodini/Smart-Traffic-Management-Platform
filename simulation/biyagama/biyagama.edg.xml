<?xml version="1.0" encoding="UTF-8"?>
<!--
  Biyagama Junction — Edge Definitions
  SOUTH of Kaduwela | 3-arm bidirectional | 2 lanes | 50 km/h
  Green Wave offset = 270 s

  North → Kaduwela      (GREEN WAVE upstream link)
  East  → Industrial Zone
  West  → Kelaniya
-->
<edges>
    <!-- North arm: Kaduwela (GREEN WAVE link) -->
    <edge id="kaduwela_in"    from="kaduwela"        to="biyagama_center" numLanes="2" speed="13.89"/>
    <edge id="kaduwela_out"   from="biyagama_center" to="kaduwela"        numLanes="2" speed="13.89"/>

    <!-- East arm: Industrial Zone -->
    <edge id="industrial_in"  from="industrial"      to="biyagama_center" numLanes="2" speed="13.89"/>
    <edge id="industrial_out" from="biyagama_center" to="industrial"      numLanes="2" speed="13.89"/>

    <!-- West arm: Kelaniya -->
    <edge id="kelaniya_in"    from="kelaniya"        to="biyagama_center" numLanes="2" speed="13.89"/>
    <edge id="kelaniya_out"   from="biyagama_center" to="kelaniya"        numLanes="2" speed="13.89"/>
</edges>
