<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kotikawatta Junction — Node Definitions
  ==========================================
  Kotikawatta is EAST of Kaduwela. Green Wave offset = 180 s.
    Distance from Kaduwela: ~2 000 m  |  Speed: 40 km/h → 180 s travel time

  Compass layout (local to this junction):
    West   → Kaduwela    (GREEN WAVE link back to origin)
    East   → Kolonnawa
    South  → Mulleriyawa
-->
<nodes>
    <node id="kotikawatta_center" x="0.0"   y="0.0"    type="traffic_light"/>
    <node id="kaduwela"           x="-500.0" y="0.0"   type="priority"/>  <!-- West   -->
    <node id="kolonnawa"          x="500.0"  y="0.0"   type="priority"/>  <!-- East   -->
    <node id="mulleriyawa"        x="0.0"   y="-500.0" type="priority"/>  <!-- South  -->
</nodes>
