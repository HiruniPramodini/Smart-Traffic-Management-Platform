<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ranala Junction — Traffic Light Logic
  ========================================
  WEST of Kaduwela | Green Wave offset = 450 s
    Travel: ~5 000 m @ 40 km/h = 450 s from Kaduwela

  3-arm junction cycle = 128 s
  Signal positions (12 chars: 3 arms × 2 lanes × 2 directions):
    0-1:  kaduwela_in    (East arm, GREEN WAVE arrival direction)
    2-3:  hanwella_in    (West arm)
    4-5:  avissawella_in (South arm)
    6-7:  kaduwela_out   (uncontrolled)
    8-9:  hanwella_out
    10-11: avissawella_out
-->
<additional>
    <tlLogic id="ranala_center" type="static" programID="green_wave_ranala" offset="450">
        <!-- Phase A: East arm (Kaduwela arrivals) GREEN — aligned to green wave -->
        <phase duration="60" state="GGrrrrGGrrrr"/>
        <phase duration="4"  state="yyrrrryyrrrr"/>
        <!-- Phase B: West (Hanwella) + South (Avissawella) cross-traffic GREEN -->
        <phase duration="60" state="rrGGrrrrGGrr"/>
        <phase duration="4"  state="rryyrrrryyrr"/>
    </tlLogic>
</additional>
