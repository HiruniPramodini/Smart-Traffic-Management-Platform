<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ranala Junction — Edge Definitions
  WEST of Kaduwela | 3-arm bidirectional | 2 lanes | 50 km/h
  Green Wave offset = 450 s

  East  → Kaduwela    (GREEN WAVE upstream link)
  West  → Hanwella
  South → Avissawella road
-->
<edges>
    <!-- East arm: Kaduwela (GREEN WAVE link) -->
    <edge id="kaduwela_in"     from="kaduwela"      to="ranala_center" numLanes="2" speed="13.89"/>
    <edge id="kaduwela_out"    from="ranala_center" to="kaduwela"      numLanes="2" speed="13.89"/>

    <!-- West arm: Hanwella -->
    <edge id="hanwella_in"     from="hanwella"      to="ranala_center" numLanes="2" speed="13.89"/>
    <edge id="hanwella_out"    from="ranala_center" to="hanwella"      numLanes="2" speed="13.89"/>

    <!-- South arm: Avissawella road -->
    <edge id="avissawella_in"  from="avissawella"   to="ranala_center" numLanes="2" speed="13.89"/>
    <edge id="avissawella_out" from="ranala_center" to="avissawella"   numLanes="2" speed="13.89"/>
</edges>
