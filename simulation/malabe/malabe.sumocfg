<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="malabe.net.xml"/>
        <route-files value="malabe.rou.xml"/>
        <additional-files value="malabe.tll.xml"/>
    </input>
    <output>
        <summary-output value="../../data/processed/malabe_summary.xml"/>
        <tripinfo-output value="../../data/processed/malabe_tripinfo.xml"/>
        <queue-output value="../../data/processed/malabe_queues.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="86400"/>
        <step-length value="1"/>
    </time>
    <report>
        <verbose value="true"/>
        <no-step-log value="false"/>
    </report>
</configuration>